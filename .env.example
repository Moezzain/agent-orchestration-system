# Copy to .env at repo root. Never commit .env.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Infra (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Redis logical DB map (documented here, enforced in code):
#   /0 celery broker · /1 celery results · /2 working memory · /3 rate limits

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tools
TAVILY_API_KEY=

# Model routing ("provider:model"); defaults shown. LLM_CHEAP_MODE=true forces
# the cheapest model everywhere (dev iteration without strong-model prices).
# SUPERVISOR_MODEL=anthropic:claude-sonnet-5
# SPECIALIST_MODEL=anthropic:claude-haiku-4-5
# REVIEWER_MODEL=openai:gpt-5
LLM_CHEAP_MODE=false
